-+import { useEffect, useState } from 'react';
-+
-+export function useDebounce<T>(value: T, delay: number) {
-+  const [debounced, setDebounced] = useState(value);
-+  useEffect(() => {
-+    const t = setTimeout(() => setDebounced(value), delay);
-+    return () => clearTimeout(t);
-+  }, [value, delay]);
-+  return debounced;
-+}
