-+    queryKey: ['policies', filters],
-+    queryFn: () => fetchPolicies(filters),
-+    staleTime: 5 * 60_000,
-+  });
-+}
-+
-+export function usePolicy(id: string) {
-+  return useQuery({
-+    queryKey: ['policy', id],
-+    queryFn: () => fetchPolicy(id),
